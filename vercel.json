{
  "rewrites": [
    {
      "source": "/api/ai/status",
      "destination": "/api/debate?aiStatus=1"
    },
    {
      "source": "/api/verify",
      "destination": "/api/credentials?public=1"
    },
    {
      "source": "/api/auth/local",
      "destination": "/api/auth/session?localAuth=1"
    },
    {
      "source": "/api/zk/status",
      "destination": "/api/learning-records?zkAction=status"
    },
    {
      "source": "/api/zk/proofs/:proofId",
      "destination": "/api/learning-records?zkAction=getProof&proofId=:proofId"
    },
    {
      "source": "/api/zk/generate",
      "destination": "/api/learning-records?zkAction=generateProof"
    },
    {
      "source": "/api/zk/verify",
      "destination": "/api/learning-records?zkAction=verifyProof"
    },
    {
      "source": "/verify",
      "destination": "/verify.html"
    }
  ],
  "installCommand": "npm ci && node scripts/zk-verification-artifacts.mjs --check",
  "functions": {
    "api/learning-records/index.js": {
      "includeFiles": "zk/build/*.json"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()" },
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'self'" }
      ]
    }
  ]
}