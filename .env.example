# Create a new LLM key at https://anyrouter.dev/dashboard/keys.
# Used by the website support widget only (api/support.js).
# Current inference keys start with sk-ar-v1-. Never commit the real value.
ANYROUTER_API_KEY=sk-ar-v1-replace-me

# Optional. The default is the currently available free router.
ANYROUTER_MODEL=anyrouter/free

# AI Learning — multi-provider gateway, server-side only (api/_ai/*).
# Order: Gemini (primary) -> AnyRouter (fallback).
# AnyRouter here uses a SEPARATE key from the support widget (ANYROUTER_API_KEY)
# so AI Learning cannot consume or expose the support key.
# Leave a key empty to mark that provider as not configured.
# Paste real keys only into .env (gitignored) or the Vercel dashboard.
GEMINI_API_KEY=
# Optional second/third Gemini keys for separate projects/environments.
# The gateway uses only GEMINI_API_KEY; numbered keys are not auto-rotated.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_MODEL=gemini-3.5-flash
ANYROUTER_LEARNING_API_KEY=
# Optional second/third AnyRouter keys for separate projects/environments.
# The gateway uses only ANYROUTER_LEARNING_API_KEY; numbered keys are not auto-rotated.
ANYROUTER_LEARNING_API_KEY_2=
ANYROUTER_LEARNING_API_KEY_3=
ANYROUTER_LEARNING_MODEL=anyrouter/free

# Optional gateway tuning. Retries are capped at 3 and the total deadline
# bounds the combined time spent across all providers.
# AI_PROVIDER_TIMEOUT_MS=10000
# AI_TOTAL_TIMEOUT_MS=26000
# AI_MAX_RETRIES=1
# AI_RETRY_DELAY_MS=300
# Optional order override. Must be known provider ids separated by commas.
# AI_PROVIDER_ORDER=gemini,anyrouter

# Registration OTP. Generate OTP_SECRET with at least 32 random characters.
OTP_SECRET=replace-with-a-long-random-secret
RESEND_API_KEY=re_replace-me
OTP_FROM_EMAIL=PARADOX <no-reply@your-domain.example>

# Optional OTP rate limiting, applied to signup, OTP send and OTP verify.
# Counters live in memory per serverless instance; see README before relying on them.
OTP_SEND_COOLDOWN_SECONDS=60
OTP_SEND_EMAIL_LIMIT=5
OTP_SEND_IP_LIMIT=20
OTP_SEND_WINDOW_MINUTES=60
OTP_VERIFY_EMAIL_LIMIT=10
OTP_VERIFY_IP_LIMIT=50
OTP_VERIFY_WINDOW_MINUTES=15
# RATE_LIMIT_DISABLED=1

# Credential code lookups (GET /api/credentials?code= and action "verify").
# Generous by design so nobody verifying certificates by hand is affected.
# CREDENTIAL_LOOKUP_WINDOW_MINUTES=15
# CREDENTIAL_LOOKUP_IP_LIMIT=60
# CREDENTIAL_LOOKUP_USER_LIMIT=60

# Multi-user authentication (Supabase). Keep SERVICE_ROLE server-side only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-project-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Comma-separated allowlist of administrator emails. Leave empty for no
# allowlisted admins: authorization then comes only from `app_metadata.role`.
# Do not commit real addresses here; put them in .env or the Vercel dashboard.
ADMIN_EMAILS=

# Generic SMTP delivery. Takes precedence over Gmail App Password.
# Use port 587 with STARTTLS (recommended), or port 465 with SMTP_SECURE=true.
# SMTP_REQUIRE_TLS defaults to true for remote non-secure ports.
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM_EMAIL=no-reply@your-domain.example
SMTP_FROM_NAME=PARADOX AI

# Alternative: send registration OTP from your own Gmail account instead of SMTP.
# Uncomment these lines, then remove or leave the SMTP block above unused.
# Use a Google App Password, never your normal Gmail password.
# Requires 2-Step Verification on the account.
# GMAIL_USER=your-account@gmail.com
# GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
# GMAIL_FROM_NAME=PARADOX AI

# Proof of Learning — Avalanche Fuji Testnet only (chain ID 43113).
# The official public RPC can be replaced with a dedicated Fuji RPC provider.
AVALANCHE_FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
# Public LearningCredentialRegistry deployment. The API rejects a different address.
AVALANCHE_CREDENTIAL_REGISTRY_ADDRESS=0xa0c69eE573cdA8d1d08B46f81AbfA0A15A45CF2b
# Dedicated testnet issuer wallet only. Never commit a real key or reuse a Mainnet wallet.
AVALANCHE_ISSUER_PRIVATE_KEY=0xreplace-with-a-new-fuji-only-private-key
# Required only for the command that broadcasts a deployment transaction.
# AVALANCHE_DEPLOY_CONFIRM=DEPLOY_LEARNING_CREDENTIAL_REGISTRY_TO_FUJI
# Emergency override only after checking the existing manifest/pending transaction.
# AVALANCHE_ALLOW_REDEPLOY=1
